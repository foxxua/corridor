### IntelliJ IDEA ###
# Політика: у git іде те, що має бути однаковим у IDE, у CLI та в агента.
# Особисте й локальне — не йде ніколи.
.idea/*
!.idea/.gitignore
!.idea/misc.xml
!.idea/gradle.xml
!.idea/vcs.xml
!.idea/kotlinc.xml
!.idea/runConfigurations/
!.idea/codeStyles/
!.idea/inspectionProfiles/

# Згенероване з Gradle-моделі: відтворюється само, тримати в git нема сенсу.
# modules.xml, compiler.xml, libraries/, jarRepositories.xml — саме тому під .idea/*

*.iml
*.iws
*.ipr
out/

